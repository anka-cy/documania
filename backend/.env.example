# Base de données (MySQL 8+)
DB_URL=jdbc:mysql://localhost:3306/documania-db?sslMode=DISABLED
DB_USERNAME=root
DB_PASSWORD=your_password_here

# Compte admin créé au premier démarrage
API_ADMIN_EMAIL=admin@example.com
API_ADMIN_PASSWORD=change_me_123!

# Mail SMTP (optionnel — nécessaire pour les emails de confirmation/reset)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_smtp_password
MAIL_FROM=noreply@example.com

# URL frontend (pour les liens dans les emails)
APP_FRONTEND_BASE_URL=http://localhost:8080

# JWT secret (minimum 32 caractères — générer avec : openssl rand -base64 64)
JWT_SECRET=change_this_to_a_random_secret_at_least_32_chars
